# ===== Públicas (podem ir para o navegador) =====
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-anon-public-key
# Endereço do site (usado no robots/sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== Só para o script de criação da proprietária (scripts/create-owner.mjs) =====
# NUNCA coloque isso no Cloudflare nem no código. Use só no seu computador, no .env.local.
SUPABASE_SERVICE_ROLE_KEY=
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=
